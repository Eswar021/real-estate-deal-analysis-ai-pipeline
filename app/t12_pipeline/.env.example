# Copy this file to `.env` (same folder) and fill in your OWN API keys.
# The pipeline reads app/t12_pipeline/.env. Never commit the real .env.

# ── Anthropic / Claude (used by the T12 structure agent + diagnosis) ──────────
CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── OpenAI (optional — alternative provider for the mapping agent) ────────────
OPENAI_API_KEY_AI_MAPPING=
OPENAI_MODEL=gpt-5-nano

# ── Google / Gemini (optional provider) ──────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── LM Studio (optional — local, OpenAI-compatible; not secret) ───────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen2.5-coder-14b
LMSTUDIO_API_KEY=lm-studio
