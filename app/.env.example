# T12 pipeline — environment template.
#
# Copy to app/.env and fill in. app/.env is gitignored and must NEVER be committed.
#   cp app/.env.example app/.env
#
# The pipeline needs exactly ONE key. All three AI agents (structure, diagnosis, mapping)
# run on Anthropic; see t12_pipeline/config/agent_llm_config.py.

# Required — your Anthropic API key.
CLAUDE_API_KEY=

# Optional — logging OVERRIDES. Leave these commented out: the real setting lives in
# t12_pipeline/config/logging.json, and anything set here SHADOWS that file.
# Use them for a one-off run instead:  T12_LOG_PROFILE=verbose python manage.py runserver
# T12_LOG_PROFILE=verbose         # summary (default) | verbose (+ per-row scoring, LLM I/O)
# T12_LOG_FILE=t12.log            # written under app/logs/
# T12_LOG_LEVEL=DEBUG

# Optional — per-agent model overrides. Defaults are set in agent_llm_config.py:
#   mapping   = claude-sonnet-5   (highest volume: one call per unmapped row)
#   structure = claude-opus-4-8   (unknown formats only)
#   diagnosis = claude-opus-4-8   (fires only when NOI verification fails)
# T12_MAPPING_MODEL=claude-sonnet-5
# T12_STRUCTURE_MODEL=claude-opus-4-8
# T12_DIAGNOSIS_MODEL=claude-opus-4-8
